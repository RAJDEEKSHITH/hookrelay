{
  "name": "hookrelay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @hookrelay/db db:generate",
    "db:migrate": "pnpm --filter @hookrelay/db db:migrate",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "load-test": "tsx --env-file=.env scripts/load-test.ts",
    "load-test:k6": "k6 run scripts/load-test.k6.js",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "3.9.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "7.0.2",
    "vitest": "~5.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
