NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay
REDIS_URL=redis://localhost:6379

# 32 bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
# At least 32 characters: openssl rand -base64 48
COOKIE_SECRET=

PORT=3000
DASHBOARD_URL=http://localhost:5173

# true only for local development, so endpoints can point at the demo receiver on localhost
ALLOW_HTTP_DESTINATIONS=true
ALLOW_PRIVATE_DESTINATIONS=true

WORKER_CONCURRENCY=20
DEMO_PORT=4000
